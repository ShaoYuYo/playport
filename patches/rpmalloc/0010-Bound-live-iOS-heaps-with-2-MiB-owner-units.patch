From a93046e3ef622be9556fbbbf964932617de6d9c9 Mon Sep 17 00:00:00 2001
From: Playport <playport@localhost>
Date: Sat, 17 Oct 2026 19:01:49 +0800
Subject: [PATCH] Bound live iOS allocator heaps with consistent 2 MiB owner
 units

The supplied startup failure exhausted the 768 MiB translator arena.
Keep mask, mapping alignment and all cached span types at 2 MiB; use
512 KiB medium pages and exact huge mappings above 1 MiB. Preserve
the public alignment limit and all non-iOS geometry. Do not free live
heaps, shrink call/return windows or change the JIT cache.

Class: ios-port
Evidence: docs/evidence/2026-10-17-unified-sidebar-live-heaps.md
Offered-upstream: no (bounded iOS translator arena)
---
 rpmalloc/rpmalloc.c | 30 +++++++++++++++++-------------
 1 file changed, 17 insertions(+), 13 deletions(-)

diff --git a/rpmalloc/rpmalloc.c b/rpmalloc/rpmalloc.c
index ed506cb..c02863b 100644
--- a/rpmalloc/rpmalloc.c
+++ b/rpmalloc/rpmalloc.c
@@ -169,7 +169,7 @@ madvise(caddr_t, size_t, int);
 #define SMALL_BLOCK_SIZE_LIMIT (4 * 1024)
 #define MEDIUM_BLOCK_SIZE_LIMIT (256 * 1024)
 #ifdef FEX_IOS_HOST
-#define LARGE_BLOCK_SIZE_LIMIT (2 * 1024 * 1024)
+#define LARGE_BLOCK_SIZE_LIMIT (1 * 1024 * 1024)
 #else
 #define LARGE_BLOCK_SIZE_LIMIT (8 * 1024 * 1024)
 #endif
@@ -177,7 +177,7 @@ madvise(caddr_t, size_t, int);
 #define SMALL_SIZE_CLASS_COUNT 73
 #define MEDIUM_SIZE_CLASS_COUNT 24
 #ifdef FEX_IOS_HOST
-#define LARGE_SIZE_CLASS_COUNT 12
+#define LARGE_SIZE_CLASS_COUNT 8
 #else
 #define LARGE_SIZE_CLASS_COUNT 20
 #endif
@@ -187,16 +187,16 @@ madvise(caddr_t, size_t, int);
 #define SMALL_PAGE_SIZE (1 << SMALL_PAGE_SIZE_SHIFT)
 #define SMALL_PAGE_MASK (~((uintptr_t)SMALL_PAGE_SIZE - 1))
 #ifdef FEX_IOS_HOST
-#define MEDIUM_PAGE_SIZE_SHIFT 20
+#define MEDIUM_PAGE_SIZE_SHIFT 19
 #else
 #define MEDIUM_PAGE_SIZE_SHIFT 22
 #endif
 #define MEDIUM_PAGE_SIZE (1 << MEDIUM_PAGE_SIZE_SHIFT)
 #define MEDIUM_PAGE_MASK (~((uintptr_t)MEDIUM_PAGE_SIZE - 1))
 #ifdef FEX_IOS_HOST
-/* A cached large page holds blocks through 2 MiB. Larger requests use
- * exact-size huge mappings rather than forcing every span to align to 16 MiB. */
-#define LARGE_PAGE_SIZE_SHIFT 22
+/* Keep the largest cached block below half a 2 MiB owner unit.
+ * Larger requests use exact-size huge mappings. */
+#define LARGE_PAGE_SIZE_SHIFT 21
 #else
 #define LARGE_PAGE_SIZE_SHIFT 26
 #endif
@@ -204,23 +204,24 @@ madvise(caddr_t, size_t, int);
 #define LARGE_PAGE_MASK (~((uintptr_t)LARGE_PAGE_SIZE - 1))
 
 #ifdef FEX_IOS_HOST
-/* Uniform 4 MiB span units let the allocator use fragmented host-arena
- * gaps. Span alignment, lookup mask and largest cached page must agree. */
-static const char ios_span4_marker[] __attribute__((used)) = "rpmalloc-span4 rev=pp-r11 huge-above=2MiB";
-#define SPAN_SIZE (4 * 1024 * 1024)
+/* Uniform 2 MiB owner units bound each live heap without leaving holes
+ * that only non-rpmalloc allocations can fill. Mask, alignment and largest
+ * cached page change together. The public 256 KiB alignment limit stays. */
+static const char ios_span2_marker[] __attribute__((used)) = "rpmalloc-span2 rev=pp-r18 huge-above=1MiB";
+#define SPAN_SIZE (2 * 1024 * 1024)
 #else
 #define SPAN_SIZE (256 * 1024 * 1024)
 #endif
 #define SPAN_MASK (~((uintptr_t)(SPAN_SIZE - 1)))
 
 // Keep span size and alignment consistent with mask-based owner lookup.
-// On iOS, all cached pages fit a 4 MiB span; requests above 2 MiB use the
+// On iOS, all cached pages fit a 2 MiB span; requests above 1 MiB use the
 // existing exact-size huge path. User pointers remain within the first
 // span unit even for huge allocations and supported explicit alignments.
 // Only map the pages this type needs initially; subsequent spans grow on demand.
 #ifdef FEX_IOS_HOST
-#define SMALL_SPAN_SIZE (4 * 1024 * 1024)
-#define MEDIUM_SPAN_SIZE (4 * 1024 * 1024)
+#define SMALL_SPAN_SIZE (2 * 1024 * 1024)
+#define MEDIUM_SPAN_SIZE (2 * 1024 * 1024)
 #else
 #define SMALL_SPAN_SIZE SPAN_SIZE
 #define MEDIUM_SPAN_SIZE SPAN_SIZE
@@ -627,7 +628,10 @@ static const size_class_t global_size_class[SIZE_CLASS_COUNT] = {
     MCLASS(2048),   MCLASS(2560),   MCLASS(3072),   MCLASS(3584),   MCLASS(4096),   MCLASS(5120),   MCLASS(6144),
     MCLASS(7168),   MCLASS(8192),   MCLASS(10240),  MCLASS(12288),  MCLASS(14336),  MCLASS(16384),  LCLASS(20480),
     LCLASS(24576),  LCLASS(28672),  LCLASS(32768),  LCLASS(40960),  LCLASS(49152),  LCLASS(57344),  LCLASS(65536),
+
+#if LARGE_SIZE_CLASS_COUNT > 8
     LCLASS(81920),  LCLASS(98304),  LCLASS(114688), LCLASS(131072),
+#endif
 #if LARGE_SIZE_CLASS_COUNT > 12
     LCLASS(163840), LCLASS(196608), LCLASS(229376), LCLASS(262144),
     LCLASS(327680), LCLASS(393216), LCLASS(458752), LCLASS(524288),
