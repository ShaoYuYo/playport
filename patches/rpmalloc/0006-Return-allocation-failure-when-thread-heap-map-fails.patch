From e92a2292987b0511fc557167061af9c299c7691d Mon Sep 17 00:00:00 2001
From: Playport <playport@localhost>
Date: Sat, 17 Oct 2026 00:21:52 +0800
Subject: [PATCH] Return allocation failure when thread heap map fails

Check metadata mappings before committing or initializing them. Retain
the fallback TLS heap on failure and stop small/huge lazy-init paths
when no real heap could be assigned, avoiding NULL access or recursion.
A subsequent allocation may retry after capacity becomes available.

Class: ios-port
Evidence: docs/evidence/2026-10-17-rpmalloc-capacity.md
Offered-upstream: no (iOS port allocator integration)
---
 rpmalloc/rpmalloc.c | 14 ++++++++++++--
 1 file changed, 12 insertions(+), 2 deletions(-)

diff --git a/rpmalloc/rpmalloc.c b/rpmalloc/rpmalloc.c
index bbc27dc..e5fc53a 100644
--- a/rpmalloc/rpmalloc.c
+++ b/rpmalloc/rpmalloc.c
@@ -801,7 +801,8 @@ get_thread_heap(void) {
 static heap_t*
 get_thread_heap_allocate(void) {
 	heap_t* heap = heap_allocate(0);
-	set_thread_heap(heap);
+	if (heap)
+		set_thread_heap(heap);
 	return heap;
 }
 
@@ -2468,6 +2469,10 @@ heap_allocate_new(void) {
 	size_t offset = 0;
 	size_t mapped_size = 0;
 	block_t* block = global_memory_interface->memory_map(heap_size, 0, &offset, &mapped_size);
+	if (!block) {
+		errno = ENOMEM;
+		return 0;
+	}
 #if ENABLE_DECOMMIT
 	global_memory_interface->memory_commit(block, heap_size);
 #endif
@@ -2719,7 +2724,10 @@ ios_skip_thread_free_drain:;
 	if (heap->id == 0) {
 		// Thread has not yet initialized, assign heap and try again
 		rpmalloc_initialize(0);
-		return heap_get_page(get_thread_heap(), size_class);
+		heap_t* initialized = get_thread_heap();
+		if (initialized->id == 0)
+			return 0;
+		return heap_get_page(initialized, size_class);
 	}
 
 	// Fallback path, find or allocate span for given size class
@@ -2819,6 +2827,8 @@ heap_allocate_block_huge(heap_t* heap, size_t size, unsigned int zero) {
 	if (heap->id == 0) {
 		rpmalloc_initialize(0);
 		heap = get_thread_heap();
+		if (heap->id == 0)
+			return 0;
 	}
 	size_t alloc_size = get_page_aligned_size(size + SPAN_HEADER_SIZE);
 	size_t offset = 0;
-- 
