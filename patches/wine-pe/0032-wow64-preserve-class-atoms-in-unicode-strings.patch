From 3eb7e01ca7368fa615dfdf4b5cd555611f9b33f8 Mon Sep 17 00:00:00 2001
From: Playport <playport@localhost>
Date: Wed, 14 Oct 2026 23:03:32 +0800
Subject: [PATCH] wow64: preserve integer class atoms in zero-length Unicode
 strings

Class: ios-port

Evidence: docs/evidence/2026-10-14-windows-compatibility-audit.md; actual header conversion regression and phone USER creation error 6

Offered-upstream: no; downstream iOS guest-window translation fix
---
 dlls/wow64/wow64_private.h | 6 +++++-
 1 file changed, 5 insertions(+), 1 deletion(-)

diff --git a/dlls/wow64/wow64_private.h b/dlls/wow64/wow64_private.h
index 8225b96..de625af 100644
--- a/dlls/wow64/wow64_private.h
+++ b/dlls/wow64/wow64_private.h
@@ -162,7 +162,11 @@ static inline UNICODE_STRING *unicode_str_32to64( UNICODE_STRING *str, const UNI
     if (!str32) return NULL;
     str->Length = str32->Length;
     str->MaximumLength = str32->MaximumLength;
-    str->Buffer = wow64_to_host( str32->Buffer );
+    /* A zero-length USER class name can carry an integer atom, not a
+     * dereferenceable string. Keep that value for IS_INTRESOURCE/LOWORD;
+     * adding the window base makes native USER treat it as a string. */
+    str->Buffer = !str32->Length && str32->Buffer <= 0xffff
+                  ? ULongToPtr( str32->Buffer ) : wow64_to_host( str32->Buffer );
     return str;
 }
 
